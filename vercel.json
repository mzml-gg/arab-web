{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/u/(.*)", "dest": "/user.html" },
    { "src": "/c/(.*)", "dest": "/code.html" },
    { "src": "/ai", "dest": "/404.html" },
    { "src": "/(.*)", "dest": "/$1", "continue": true },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
