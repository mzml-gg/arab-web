{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/ai",
      "destination": "/ai.html"
    },
    {
      "source": "/u/(.*)",
      "destination": "/user"
    },
    {
      "source": "/c/(.*)",
      "destination": "/code"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
