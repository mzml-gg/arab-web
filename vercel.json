{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/u/(.*)", "destination": "/user.html" },
    { "source": "/c/(.*)", "destination": "/code.html" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/u/.*", "dest": "/user.html" },
    { "src": "/c/.*", "dest": "/code.html" },
    { "src": "/api/.*", "dest": "/api/index" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
