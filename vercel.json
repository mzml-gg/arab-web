{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/u/:username", "destination": "/user.html" },
    { "source": "/c/:filename", "destination": "/code.html" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/u/(.*)", "dest": "/user.html" },
    { "src": "/c/(.*)", "dest": "/code.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
