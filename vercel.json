{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/ai",
      "destination": "/ai.html"
    },
    {
      "source": "/u/(.*)",
      "destination": "/user"
    },
    {
      "source": "/c/(.*)",
      "destination": "/code"
    }
  ],
  "errorPages": [
    {
      "status": 404,
      "src": "/404.html"
    }
  ]
}
